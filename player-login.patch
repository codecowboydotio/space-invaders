   const scoreEl = document.getElementById("scoreVal");
   const waveEl = document.getElementById("waveVal");
   const hiEl = document.getElementById("hiVal");
@@ -450,14 +496,91 @@
   const overlayText = document.getElementById("overlayText");
   const startBtn = document.getElementById("startBtn");
 
+  const loginOverlay = document.getElementById("loginOverlay");
+  const loginForm = document.getElementById("loginForm");
+  const nameInput = document.getElementById("nameInput");
+  const loginError = document.getElementById("loginError");
+
+  /* ---------------------------------------------------------
+     PLAYER LOGIN
+     Captures the pilot's callsign before the game starts.
+     The name is sanitised, persisted to localStorage, shown in
+     the HUD, and used as the LaunchDarkly context key so flag
+     targeting can be per-player.
+  --------------------------------------------------------- */
+  const PLAYER_NAME_KEY = "galactic-defender-player";
+  const MAX_NAME_LEN = 12;
+  let playerName = "";
+
+  // Strip anything that isn't a letter, number, space, dash or underscore so
+  // the arcade font renders cleanly and nothing HTML-unsafe reaches the DOM.
+  function sanitizeName(raw){
+    return (raw || "")
+      .replace(/[^A-Za-z0-9 _-]/g, "")
+      .replace(/\s+/g, " ")
+      .trim()
+      .slice(0, MAX_NAME_LEN)
+      .toUpperCase();
+  }
+
+  function loadStoredName(){
+    try{ return sanitizeName(localStorage.getItem(PLAYER_NAME_KEY) || ""); }
+    catch(_){ return ""; }
+  }
+  function storeName(name){
+    try{ localStorage.setItem(PLAYER_NAME_KEY, name); }catch(_){ /* private mode */ }
+  }
+
+  function setPlayerName(name){
+    playerName = name;
+    playerEl.textContent = name || "---";
+    // Best-effort: retarget the LD context to this player so flags can be
+    // evaluated per-callsign. Failure here must never block play.
+    if(ldClient && name){
+      try{ ldClient.identify({ kind:"user", key: name, name: name }); }
+      catch(_){ /* keep the anonymous context */ }
+    }
+  }
+
+  function handleLogin(e){
+    if(e) e.preventDefault();
+    const name = sanitizeName(nameInput.value);
+    if(name.length < 1){
+      loginError.textContent = "CALLSIGN REQUIRED";
+      nameInput.focus();
+      return;
+    }
+    loginError.textContent = "";
+    setPlayerName(name);
+    storeName(name);
+    loginOverlay.style.display = "none";
+    showOverlay(
+      "GALACTIC DEFENDER",
+      "Welcome, " + name + ".<br>Arrow keys or A/D to move, SPACE to fire, P to pause.",
+      "▶ START GAME"
+    );
+  }
+
+  loginForm.addEventListener("submit", handleLogin);
+
   let keys = {};
+  // True while the player is typing in a text field (e.g. the login screen),
+  // so game hotkeys don't hijack the keystrokes.
+  function isTypingTarget(e){
+    const t = e.target;
+    return t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable);
+  }
   window.addEventListener("keydown", (e)=>{
+    if(isTypingTarget(e)) return;
     keys[e.code] = true;
     if(e.code === "Space") e.preventDefault();
     if(e.code === "KeyP") togglePause();
     if(e.code === "KeyR") restartGame();
   });
-  window.addEventListener("keyup", (e)=>{ keys[e.code] = false; });
+  window.addEventListener("keyup", (e)=>{
+    if(isTypingTarget(e)) return;
+    keys[e.code] = false;
+  });
 
   /* ---------------------------------------------------------
      TOUCH CONTROLS
@@ -623,6 +746,7 @@
   }
 
   function restartGame(){
+    loginOverlay.style.display = "none"; // never leave the login screen stuck over a live game
     resetGame();
     state = STATE.PLAYING;
     hideOverlay();
@@ -861,6 +985,16 @@
      INIT
   --------------------------------------------------------- */
   async function init(){
+    // Reveal the login screen immediately — before any async SDK work — so it
+    // shows deterministically from JS. loginOverlay is display:none in markup,
+    // so if the feature is ever gated off, the control path never flashes it
+    // in and back out.
+    const saved = loadStoredName();
+    if(saved) nameInput.value = saved;
+    overlay.style.display = "none";
+    loginOverlay.style.display = "flex";
+    nameInput.focus();
+
     await initLaunchDarkly();
     const shipPath = currentShooterSpritePath();
 
@@ -886,8 +1020,12 @@
     subscribeToSpriteChanges();
 
     spawnWave(wave);
+
+    // Now that the LD client exists, reflect any saved callsign in the HUD and
+    // retarget the LD context (identify() is a no-op until ldClient is ready).
+    if(saved) setPlayerName(saved);
     updateHud();
-    showOverlay("GALACTIC DEFENDER", "Defend the last frontier.<br>Arrow keys or A/D to move, SPACE to fire, P to pause.", "▶ START GAME");
+
     requestAnimationFrame(loop);
   }
 
